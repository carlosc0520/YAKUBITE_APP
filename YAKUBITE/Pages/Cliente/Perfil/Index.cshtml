@page
@model YAKUBITE.Pages.Cliente.Perfil.IndexModel
@{
    Layout = "Layouts/_FrontLayout";
    ViewData["Title"] = "Cliente - Perfil";
}
@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-profile.dist.css" />
}

@section PageScripts {
    <script src="~/app/ADMIN/PERFIL/index.js"></script>
}

@* ************** Content ************** *@

<div class="container-xxl mt-5 py-5" style="margin-top: 5rem !important;">
    <div class="container">
        <h4 class="py-3 breadcrumb-wrapper mb-4">
            <span class="text-muted fw-light">Mi Perfil /</span> Datos
        </h4>

        <!-- Header -->
        <div class="row">
            <div class="col-12">
                <div class="card mb-4">
                    <div class="user-profile-header-banner">
                        <img src="~/img/pages/profile-banner.png" alt="Banner image" class="rounded-top">
                    </div>
                    <div class="user-profile-header d-flex flex-column flex-sm-row text-sm-start text-center mb-4">
                        <div class="flex-shrink-0 mt-n2 mx-sm-0 mx-auto">
                            <!-- https://placehold.co/50x50' -->
                            <img id="IMG_USER"
                                 src=""
                                 onerror="this.src='~/img/avatars/5.png';"
                                 alt="user image" class="d-block h-auto ms-0 ms-sm-4 rounded-3 user-profile-img">
                        </div>
                        <div class="flex-grow-1 mt-3 mt-sm-5">
                            <div class="d-flex align-items-md-end align-items-sm-start align-items-center justify-content-md-between justify-content-start mx-4 flex-md-row flex-column gap-4">
                                <div class="user-profile-info">
                                    <h4 id="NOMBRE_USER"></h4>
                                    <!-- // PERFIL -->
                                    <p id="PERFIL_USER"></p>
                                    <!-- // DATOS DE CONTACTO -->
                                    <ul class="list-inline mb-0 d-flex align-items-center flex-wrap justify-content-sm-start justify-content-center gap-2">
                                        <li class="list-inline-item fw-medium">
                                            <i class='bx bx-envelope'></i>
                                            <span id="EMAIL_USER">

                                            </span>
                                        </li>
                                        <li class="list-inline-item fw-medium">
                                            <i class='bx bx-phone'></i>
                                            <span id="TELEFONO_USER">

                                            </span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--/ Header -->
        <!-- Navbar pills -->
        <div class="row">
            <div class="col-md-12">
                <ul class="nav nav-pills flex-column flex-sm-row mb-4">
                    <li class="nav-item"><a class="nav-link active" href="javascript:void(0);"><i class='bx bx-grid-alt me-1'></i>Recompensas</a></li>
                </ul>
            </div>
        </div>
        <!--/ Navbar pills -->
        <!-- Project Cards -->
        <div class="row g-4" id="contenedor-recompensas">
        </div>
        <!--/ Project Cards -->
    </div>
</div>
