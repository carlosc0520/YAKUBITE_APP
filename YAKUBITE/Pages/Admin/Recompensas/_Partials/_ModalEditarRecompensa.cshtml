<div class="modal fade" id="modalEditRecompensa" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-simple modal-edit-user">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="text-center mb-4">
                    <h3>Editar Recompensa</h3>
                </div>
                <form id="EditRecompensa" class="row g-3" method="post">
                    <div class="col-12">
                        <label class="form-label" for="NOMBRE">Nombre <span class="text-danger">*</span></label>
                        <input type="text" id="NOMBRE" name="NOMBRE" class="form-control max-length"/>
                    </div>

                    <div class="col-12">
                        <label class="form-label" for="DESCRIPCION">Descripción <span class="text-danger">*</span></label>
                        <textarea id="DESCRIPCION" name="DESCRIPCION" class="form-control max-length" rows="5" maxlength="500" required></textarea>
                    </div>
                                
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="PUNTOS">Puntos <span class="text-danger">*</span></label>
                        <input type="text" id="PUNTOS" name="PUNTOS" class="form-control solo-numero"/>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label" for="ESTADO">Estado </label>
                        <select id="ESTADO" name="ESTADO" class="select2 form-select" data-allow-clear="true">
                            <option selected value="A">Activo</option>
                            <option value="I">Inactivo</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <div action="/upload" class="dropzone needsclick
                            d-flex justify-content-center align-items-center" id="dropzone-area">
                            <div class="dz-message needsclick">
                                Arrastra la imagen aquí o haz clic para subir.
                                <span class="note needsclick">(Esta es sólo una visualización
                                    <span class="fw-medium">de la</span> imagen.)</span>
                            </div>
                            <div class="fallback">
                                <input name="FILE" name="FILE" type="FILE" accept="image/*" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12 text-center mt-4">
                        <button id="btnEditRecompensa" class="btn btn-primary me-sm-3 me-1">Guardar</button>
                        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                    </div>
                </form> 
            </div>
        </div>
    </div>
</div>
